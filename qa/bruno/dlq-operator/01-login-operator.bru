meta {
  name: 01-login-operator
  type: http
  seq: 1
}

post {
  url: {{authBaseUrl}}/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "{{operatorEmail}}",
    "password": "{{operatorPassword}}"
  }
}

tests {
  test("returns an operator token", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("object");
    expect(res.body.token).to.be.a("string").and.not.be.empty;
  });
}

script:post-response {
  bru.setVar("operatorToken", res.body.token);
}
