meta {
  name: 04 Set threshold on product-low-stock
  type: http
  seq: 4
}

put {
  url: {{inventoryBaseUrl}}/{{productLowStockId}}/threshold
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "threshold": 5
  }
}

tests {
  test("updates the low-stock threshold", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("object");
    expect(res.body.productId).to.equal(Number(bru.getVar("productLowStockId")));
    expect(res.body.threshold).to.equal(5);
  });
}
