meta {
  name: 01 Login customer-cancel
  type: http
  seq: 1
}

post {
  url: {{authBaseUrl}}/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "{{customerCancelEmail}}",
    "password": "{{customerPassword}}"
  }
}

script:post-response {
  bru.setVar("customerToken", res.body.token);
}
