        {
          "name": "place-order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderProducts\": [\n    {\n      \"productId\": \"{{productHappyId}}\",\n      \"quantity\": 2\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{orderBaseUrl}}/{{customerHappyId}}",
              "host": ["{{orderBaseUrl}}"],
              "path": ["{{customerHappyId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('creates an order and returns a location', () => {",
                  "  pm.expect(pm.response.code).to.equal(201);",
                  "  const location = pm.response.headers.get('Location');",
                  "  pm.expect(location, 'Location header').to.be.a('string').and.not.empty;",
                  "  pm.expect(location).to.contain(pm.environment.get('customerHappyId'));",
                  "  const orderId = location.split('/').pop();",
                  "  pm.expect(orderId).to.match(/^[0-9a-fA-F-]{36}$/);",
                  "});",
                  "const location = pm.response.headers.get('Location');",
                  "if (location) {",
                  "  pm.collectionVariables.set('orderLocation', location);",
                  "  pm.collectionVariables.set('orderId', location.split('/').pop());",
                  "}",
                  "pm.collectionVariables.set('pollAttempts', 0);"
                ]
              }
            }
          ]
        },
        {
          "name": "poll-order",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }]
            },
            "url": {
              "raw": "{{orderBaseUrl}}/{{customerHappyId}}/{{orderId}}",
              "host": ["{{orderBaseUrl}}"],
              "path": ["{{customerHappyId}}", "{{orderId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const TERMINAL = 'Confirmed';",
                  "const MAX_ATTEMPTS = 80;",
                  "pm.test('poll-order response shape', () => {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.be.an('object');",
                  "  pm.expect(body.orderId).to.equal(pm.collectionVariables.get('orderId'));",
                  "  pm.expect(body.customerId).to.equal(pm.environment.get('customerHappyId'));",
                  "  pm.expect(body.status).to.be.a('string').and.not.empty;",
                  "});",
                  "const status = pm.response.json().status;",
                  "let n = Number(pm.collectionVariables.get('pollAttempts') || 0);",
                  "pm.collectionVariables.set('orderStatus', status);",
                  "if (status === TERMINAL) {",
                  "  pm.collectionVariables.set('pollAttempts', 0);",
                  "  pm.test(`order reached ${TERMINAL}`, () => pm.expect(status).to.equal(TERMINAL));",
                  "} else if (n + 1 >= MAX_ATTEMPTS) {",
                  "  pm.collectionVariables.set('pollAttempts', 0);",
                  "  pm.test(`order reached ${TERMINAL}`, () => pm.expect.fail(`stuck at ${status} after ${MAX_ATTEMPTS} attempts`));",
                  "} else {",
                  "  pm.collectionVariables.set('pollAttempts', n + 1);",
                  "  pm.execution.setNextRequest(pm.info.requestName);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "list-shipping-by-order",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            },
            "url": {
              "raw": "{{shippingBaseUrl}}/by-order/{{orderId}}",
              "host": ["{{shippingBaseUrl}}"],
              "path": ["by-order", "{{orderId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const MAX_ATTEMPTS = 80;",
                  "pm.test('list-shipping-by-order returns 200 array', () => {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});",
                  "const body = pm.response.json();",
                  "const arr = Array.isArray(body) ? body : [];",
                  "let n = Number(pm.collectionVariables.get('pollAttempts') || 0);",
                  "const first = arr[0];",
                  "const shipmentId = first ? (first.shipmentId || first.id) : null;",
                  "if (shipmentId) {",
                  "  pm.collectionVariables.set('pollAttempts', 0);",
                  "  pm.collectionVariables.set('shipmentId', shipmentId);",
                  "  pm.test('shipment created for order', () => {",
                  "    pm.expect(arr).to.have.lengthOf.at.least(1);",
                  "    pm.expect(first.orderId).to.equal(pm.collectionVariables.get('orderId'));",
                  "    pm.expect(first.customerId).to.equal(pm.environment.get('customerHappyId'));",
                  "    pm.expect(first.status).to.be.a('string').and.not.empty;",
                  "    pm.expect(first.lines).to.be.an('array').and.have.lengthOf.at.least(1);",
                  "  });",
                  "} else if (n + 1 >= MAX_ATTEMPTS) {",
                  "  pm.collectionVariables.set('pollAttempts', 0);",
                  "  pm.test('shipment created for order', () => pm.expect.fail(`no shipment after ${MAX_ATTEMPTS} attempts`));",
                  "} else {",
                  "  pm.collectionVariables.set('pollAttempts', n + 1);",
                  "  pm.execution.setNextRequest(pm.info.requestName);",
                  "}"
                ]
              }
            }
          ]
        },
