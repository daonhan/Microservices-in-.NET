meta {
  name: 06-dlq-batch-replay-operator
  type: http
  seq: 6
}

post {
  url: {{gatewayBaseUrl}}/operator/api/failures/replay-batch
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{operatorToken}}
}

body:json {
  {
    "ids": ["{{operatorDlqBatchAId}}", "{{operatorDlqBatchBId}}"]
  }
}

tests {
  test("operator batch replay returns 200 with two success items", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.be.an("array").and.have.lengthOf(2);
    res.body.items.forEach(function (item) {
      expect(item.status).to.equal("success");
      expect(item.newMessageId).to.be.a("string").and.not.be.empty;
    });
    const ids = res.body.items.map(function (i) { return i.id; });
    expect(ids).to.include.members([bru.getEnvVar("operatorDlqBatchAId"), bru.getEnvVar("operatorDlqBatchBId")]);
  });
}
