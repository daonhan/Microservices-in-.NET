meta {
  name: webhook
  type: http
  seq: 9
}

post {
  url: {{shippingBaseUrl}}/webhooks/carrier/fake-ground
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Carrier-Secret: {{carrierGroundSecret}}
}

body:json {
  {
    "trackingNumber": "{{shipmentDispatchedTrackingNumber}}",
    "statusCode": 2,
    "detail": "QA admin-ops webhook smoke"
  }
}

tests {
  test("ingests the carrier webhook", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("object");
    expect(res.body.shipmentId).to.equal(bru.getVar("shipmentDispatchedId"));
    expect(res.body.status).to.equal("InTransit");
  });
}
