meta {
  name: 01-issue-service-token
  type: http
  seq: 1
}

post {
  url: {{authBaseUrl}}/token
  body: form-urlencoded
  auth: none
}

headers {
  Content-Type: application/x-www-form-urlencoded
}

body:form-urlencoded {
  grant_type: client_credentials
  client_id: {{serviceClientId}}
  client_secret: {{serviceClientSecret}}
}

tests {
  test("returns a service token", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("object");
    expect(res.body.token).to.be.a("string").and.not.be.empty;
    expect(res.body.expiresIn).to.be.a("number").and.be.greaterThan(0);
  });
}

script:post-response {
  bru.setVar("serviceToken", res.body.token);
}
