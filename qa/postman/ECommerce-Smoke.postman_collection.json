    {
      "name": "01 Happy Path",
      "description": "Customer-happy buys product-happy (qty 2). Saga reaches Confirmed; admin walks the shipment to Delivered. Polling is self-contained via pm.execution.setNextRequest; runner supplies the 750ms inter-iteration delay.",
      "item": [
        {
          "name": "login-customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{customerHappyEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{authBaseUrl}}/login", "host": ["{{authBaseUrl}}"], "path": ["login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('returns a customer token', () => {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "  pm.expect(body).to.be.an('object');",
                  "  pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.expiresIn).to.be.a('number').and.greaterThan(0);",
                  "});",
                  "pm.collectionVariables.set('customerToken', body.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "login-admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{authBaseUrl}}/login", "host": ["{{authBaseUrl}}"], "path": ["login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('returns an admin token', () => {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "  pm.expect(body).to.be.an('object');",
                  "  pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.expiresIn).to.be.a('number').and.greaterThan(0);",
                  "});",
                  "pm.collectionVariables.set('adminToken', body.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "get-basket",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }]
            },
            "url": {
              "raw": "{{basketBaseUrl}}/{{customerHappyId}}",
              "host": ["{{basketBaseUrl}}"],
              "path": ["{{customerHappyId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('returns the happy customer seeded basket', () => {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "  pm.expect(body).to.be.an('object');",
                  "  pm.expect(body.customerId).to.equal(pm.environment.get('customerHappyId'));",
                  "  pm.expect(body.products).to.be.an('array').and.have.lengthOf.at.least(1);",
                  "  const product = body.products.find(p => String(p.productId) === String(pm.environment.get('productHappyId')));",
                  "  pm.expect(product, 'product-happy in basket').to.exist;",
                  "  pm.expect(product.productName).to.be.a('string').and.not.empty;",
                  "  pm.expect(product.productPrice).to.be.a('number');",
                  "  pm.expect(product.quantity).to.equal(2);",
                  "  pm.expect(body.basketTotal).to.be.a('number').and.greaterThan(0);",
                  "});"
                ]
              }
            }
          ]
        },
