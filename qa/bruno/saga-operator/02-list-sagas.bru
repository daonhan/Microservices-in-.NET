meta {
  name: 02-list-sagas
  type: http
  seq: 2
}

get {
  url: {{sagaBaseUrl}}/operator/api/sagas?type=Order&status=Running
  body: none
  auth: bearer
}

auth:bearer {
  token: {{serviceToken}}
}

tests {
  test("lists order sagas", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("object");
    expect(res.body.items).to.be.an("array");
    expect(res.body.total).to.be.a("number");
  });
}

script:post-response {
  const first = Array.isArray(res.body.items) ? res.body.items[0] : null;
  if (first && first.sagaId) {
    bru.setVar("operatorSagaId", first.sagaId);
  }
}
